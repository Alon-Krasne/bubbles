{
  "name": "bubbles-game",
  "version": "7.20.1",
  "description": "בועות! - A cooperative bubble-catching game for two players",
  "main": "index.html",
  "scripts": {
    "test:saves": "node scripts/test-save-service.mjs && node scripts/test-save-client.mjs && node scripts/test-round-saves.mjs && node scripts/test-save-body-limit.mjs",
    "dev:cloud": "npm run build && wrangler pages dev dist",
    "dev": "vite",
    "start": "vite",
    "preview": "vite preview",
    "test:trail": "node --experimental-strip-types scripts/test-trail-catalog.mjs",
    "test:track": "node scripts/test-track-progress.mjs",
    "test:vocabulary": "node --experimental-strip-types scripts/test-vocabulary.mjs",
    "test:translations": "node --experimental-strip-types scripts/test-translation-hints.mjs && node scripts/test-translation-hint-control.mjs",
    "test:vocabulary-deck": "node scripts/test-vocabulary-deck.mjs",
    "test:route-vocabulary": "node --experimental-strip-types scripts/test-route-vocabulary.mjs",
    "test:vocabulary-audio": "node scripts/test-vocabulary-audio.mjs",
    "test:store-audio": "node scripts/test-store-audio.mjs",
    "test:shop-session": "node --experimental-strip-types scripts/test-shop-session.mjs",
    "test:shop-order-hint": "node scripts/test-shop-order-hint.mjs",
    "test:shop-art": "node scripts/test-shop-art-assets.mjs",
    "test:audio-integrity": "node scripts/test-audio-integrity.mjs",
    "test:audio-playback": "node --experimental-strip-types scripts/test-audio-playback-queue.mjs",
    "test:activity-scoring": "node scripts/test-activity-scoring.mjs",
    "pretest:fast-start": "npm run build",
    "test:fast-start": "node scripts/test-fast-start-build.mjs",
    "test:memory-completion": "node --experimental-strip-types scripts/test-memory-completion.mjs",
    "test:memory-saves": "node scripts/test-memory-saves.mjs",
    "test:magic-house-variation": "node scripts/test-magic-house-variation.mjs",
    "test:magic-house-layouts": "node scripts/test-magic-house-layouts.mjs",
    "test:magic-house-hit-areas": "node scripts/test-magic-house-hit-areas.mjs",
    "test:moonlight-room": "node scripts/test-moonlight-room.mjs",
    "test:magic-house-inventory": "node scripts/run-magic-house-inventory.mjs",
    "test:magic-house-audio": "node scripts/test-magic-house-audio.mjs",
    "test:traveller-position": "node scripts/test-traveller-position.mjs",
    "build": "vite build && node scripts/copy-prototype.js",
    "generate:magic-house-tts": "node scripts/generate-magic-house-tts.js",
    "generate:vocabulary-tts": "node --experimental-strip-types scripts/generate-vocabulary-tts.mjs",
    "bundle": "vite build",
    "share": "vite build && open dist/index.html",
    "release": "npm version major --no-git-tag-version && bun run bundle"
  },
  "keywords": [
    "game",
    "kids",
    "cooperative",
    "bubbles",
    "hebrew",
    "canvas"
  ],
  "author": "Alon Krasne",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "dependencies": {
    "@cloudflare/pages-plugin-cloudflare-access": "^1.0.5",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.15.0"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "miniflare": "^5.20260907.0-alpha",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.0",
    "wrangler": "^4.129.1"
  }
}
